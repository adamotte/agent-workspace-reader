{
  "name": "__MSG_ext_name__",
  "version": "0.0.0",
  "author": "Anthony Damotte",
  "manifest_version": 3,
  "description": "__MSG_ext_desc__",
  "default_locale": "en",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "images/icon-16.png", "images/icon-32.png"],
      "matches": ["file:///*"]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "__MSG_ext_name__",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["file:///*"],
  "content_scripts": [
    {
      "js": ["js/content.js"],
      "css": ["css/content.css"],
      "matches": [
        "file://*/*.md",
        "file://*/*.mdx",
        "file://*/*.mkd",
        "file://*/*.markdown",
        "file://*/*.MD",
        "file://*/*.MDX",
        "file://*/*.MKD",
        "file://*/*.MARKDOWN",
        "file://*/*.md?*",
        "file://*/*.mdx?*",
        "file://*/*.mkd?*",
        "file://*/*.markdown?*",
        "file://*/*.MD?*",
        "file://*/*.MDX?*",
        "file://*/*.MKD?*",
        "file://*/*.MARKDOWN?*",
        "file://*/*.txt",
        "file://*/*.TXT",
        "file://*/*.txt?*",
        "file://*/*.TXT?*",
        "file://*/*.json",
        "file://*/*.JSON",
        "file://*/*.yaml",
        "file://*/*.YAML",
        "file://*/*.yml",
        "file://*/*.YML",
        "file://*/*.log",
        "file://*/*.toml",
        "file://*/*.ini",
        "file://*/*.cfg",
        "file://*/*.conf",
        "file://*/*.properties",
        "file://*/*.js",
        "file://*/*.mjs",
        "file://*/*.cjs",
        "file://*/*.css",
        "file://*/*.scss",
        "file://*/*.less",
        "file://*/*.py",
        "file://*/*.sh",
        "file://*/*.bash",
        "file://*/*.ps1",
        "file://*/*.bat",
        "file://*/*.cmd",
        "file://*/*.sql",
        "file://*/*.go",
        "file://*/*.rs",
        "file://*/*.java",
        "file://*/*.c",
        "file://*/*.h",
        "file://*/*.cpp",
        "file://*/*.cs",
        "file://*/*.tsv",
        "file://*/*/Dockerfile",
        "file://*/*/Makefile",
        "file://*/*/AUTHORS",
        "file://*/*/CHANGELOG",
        "file://*/*/COPYING",
        "file://*/*/LICENCE",
        "file://*/*/LICENSE",
        "file://*/*/NOTICE",
        "file://*/*/README",
        "file://*/*/",
        "file://*/*/?*",
        "file:///"
      ]
    }
  ],
  "commands": {
    "toggleSide": {
      "description": "__MSG_command_toggle_side__",
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    },
    "toggleCentered": {
      "description": "__MSG_command_toggle_centered__",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "toggleRefresh": {
      "description": "__MSG_command_toggle_refresh__",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggleTheme": {
      "description": "__MSG_command_toggle_theme__",
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    }
  }
}
